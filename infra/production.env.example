# Modèle de .env pour la machine de production (infra/docker-compose.prod.yml).
# Remplir chaque valeur marquée « OBLIGATOIRE », puis copier ce fichier dans /opt/lonkoo/.env (droits 600).
# Ne JAMAIS commiter le fichier rempli.

# Domaine servi (sans https:// ni barre finale), ex. lonkoo.example.com
DOMAIN=lonkoo.example.com

# PostgreSQL : mot de passe solide (générer : openssl rand -hex 24)
POSTGRES_PASSWORD=changer-moi-avec-une-valeur-solide

# Secrets d'authentification interne (au moins 32 caractères pour le ticket, 16 pour le service)
REALTIME_TICKET_SECRET=changer-moi-avec-au-moins-32-caracteres-aleatoires
REALTIME_SERVICE_TOKEN=changer-moi-avec-au-moins-16-caracteres

# Application GitHub OAuth configurée pour l'adresse de production (voir docs/GITHUB-OAUTH.md)
GITHUB_OAUTH_CLIENT_ID=votre_client_id_github
GITHUB_OAUTH_CLIENT_SECRET=votre_client_secret_github

# Réglages facultatifs (les valeurs commentées sont celles appliquées par défaut si la variable est omise) :
# GUEST_TTL_HOURS=24
# GUEST_RATE_LIMIT_PER_HOUR=20
# MAX_PROJECTS_PER_GUEST=20
# MAX_PROJECTS_PER_ACCOUNT=100
# MAX_CANVASES_PER_PROJECT=10
# MAX_VERSIONS_PER_CANVAS=50
# MAX_SHARE_LINKS_PER_CANVAS=20
# MAX_SNAPSHOT_BYTES=1048576
# MAX_GENERATIONS_PER_CANVAS=20
# MAX_GENERATED_BYTES=8388608
# Discussion d'un projet : messages par minute et par personne (20 ; 429 au-delà) et messages gardés par projet (1000)
# MAX_MESSAGES_PER_MINUTE=20
# MAX_MESSAGES_PER_PROJECT=1000
# MAX_DEPLOYMENTS_PER_GENERATION=20
# Limites du canvas en direct (realtime/src/limits.js).
# Mode : enforce (appliquées, par défaut), log (journalisées sans rien refuser), off (désactivées). 0 désactive une limite.
# Messages par seconde et par connexion (100, rafale de 300) ; octets par connexion et par 10 s (4194304) ;
# taille de l'état d'un canvas (4194304, jamais plus du double). Le backend refuse en 413 un état de plus de
# REALTIME_MAX_STORED_STATE_BYTES (16777216) : le garder au-dessus du double de REALTIME_MAX_STATE_BYTES.
# REALTIME_LIMITS_MODE=enforce
# REALTIME_MAX_MESSAGES_PER_SECOND=100
# REALTIME_MAX_BYTES_PER_10S=4194304
# REALTIME_MAX_STATE_BYTES=4194304
# REALTIME_MAX_STORED_STATE_BYTES=16777216
# Minutes au-delà desquelles un travail resté « en cours » est marqué échoué (30)
# JOB_STALE_MINUTES=30
# AI_PROVIDER=agent_ia
# AI_AGENT_URL=http://agent_ia:8000
# Obligatoire dès que AI_PROVIDER=agent_ia : 16 caractères au moins, le même pour le backend et le
# microservice, qui refuse de démarrer sans lui. Le démarrage en production est refusé s'il manque.
# AI_SERVICE_TOKEN=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=
# AI_MODEL=gemini-3.8-flash
# AI_TIMEOUT_SECONDS=30
# Temps d'attente du backend sur le microservice : doit couvrir deux appels au modèle (reprise) plus une
# marge. Refusé au démarrage en production si AI_AGENT_TIMEOUT_SECONDS < 2 x AI_TIMEOUT_SECONDS + 5.
# AI_AGENT_TIMEOUT_SECONDS=70
# AI_DAILY_QUOTA=30
# AI_GUEST_DAILY_QUOTA=5
# AI_GLOBAL_DAILY_CAP=500
# Plafonds propres au conseiller conversationnel (comptés séparément des esquisses et des audits).
# AI_CHAT_DAILY_QUOTA=60
# AI_CHAT_GUEST_DAILY_QUOTA=10
# AI_MAX_INPUT_CHARS=8000
