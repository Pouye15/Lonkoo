# Origine unique : / (interface), /api (backend), /ws (temps réel).
# DOMAINS est fourni par l'environnement : une adresse (ex. lonkoo.example.com) ou plusieurs, séparées par des virgules
# (« a.example.com, b.example.com »). Le compose lui donne DOMAIN pour valeur par défaut. Caddy obtient seul le certificat TLS
# de chaque adresse ; une adresse dont le DNS ne pointe pas encore ici échoue sans gêner les autres.
# DOMAIN est l'adresse principale (celle de l'application OAuth GitHub). Toute autre adresse de DOMAINS REDIRIGE vers elle :
# la connexion GitHub n'a qu'une adresse de retour, et le cookie d'état de la connexion appartient à l'adresse de départ ;
# servie depuis une autre adresse, elle échouait par « État de connexion invalide ».
#
# Les adresses des services valent celles du réseau Docker (voir docker-compose.prod.yml). Elles se règlent par
# variable seulement pour essayer ce fichier sans Docker (BACKEND_UPSTREAM=localhost:8080, par exemple).
#
# JOURNAUX : volontairement aucune directive « log », donc aucun journal d'accès. Le jeton d'un lien de partage est
# dans le chemin (/join/<jeton> pour la page, /api/join/<jeton> pour l'API) et ne doit jamais être écrit (S-07).
# N'activez pas les journaux sans exclure ces deux chemins avec « log_skip ».
{$DOMAINS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Autres adresses : redirection TEMPORAIRE (307 : la méthode et le chemin sont gardés) vers l'adresse principale.
	# Pas 308 : un navigateur garde une redirection permanente sans limite de durée. Le 15/11, quand lonkoo.site est passée
	# d'adresse secondaire à adresse principale, un Chrome qui avait suivi l'ancienne redirection (lonkoo.site vers sslip.io)
	# tournait en boucle (ERR_TOO_MANY_REDIRECTS) jusqu'à ce que son cache soit vidé. Une redirection temporaire n'est pas
	# gardée : l'adresse principale peut encore changer, ou revenir en arrière, sans piéger ceux qui sont déjà passés.
	@alias not host {$DOMAIN}
	redir @alias https://{$DOMAIN}{uri} 307

	# Routes réservées au backend et au serveur temps réel : jamais exposées.
	# Un « handle » et non un « respond » seul : Caddy exécute tous les « handle » avant un « respond » placé à la racine du
	# site, quel que soit l'ordre d'écriture. Le « respond » seul ne s'exécutait donc jamais : /internal/… partait vers l'interface,
	# qui répondait 404 par hasard. Le contrôle est dans scripts/check_internal_routes.sh (CI et déploiement).
	@internal path /internal /internal/*
	handle @internal {
		respond 404
	}

	handle /api/* {
		# 2 Mio : plus gros que toute requête légitime (les instantanés enregistrés font 1 Mio au plus). Au-delà : 413.
		request_body {
			max_size 2MiB
		}
		reverse_proxy {$BACKEND_UPSTREAM:backend:8080}
	}

	# Le temps réel n'expose que la poignée de main WebSocket (/ws) et sa santé (/ws/health). Le préfixe est retiré :
	# le navigateur ouvre wss://<domaine>/ws, le serveur temps réel reçoit « / » (il accepte aussi « /ws » tel quel).
	# Tout autre chemin sous /ws est refusé : une fois « /ws » retiré, /ws/internal/… arriverait aux routes /internal
	# du serveur temps réel, qui ne sont protégées que par le jeton de service.
	@ws_ouvert path /ws /ws/ /ws/health
	handle @ws_ouvert {
		uri strip_prefix /ws
		reverse_proxy {$REALTIME_UPSTREAM:realtime:1234}
	}
	@ws_autre path /ws /ws/*
	handle @ws_autre {
		respond 404
	}

	handle {
		reverse_proxy {$FRONTEND_UPSTREAM:frontend:3000}
	}
}
