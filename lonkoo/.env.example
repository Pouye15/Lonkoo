# Copier ce fichier en .env et remplacer les valeurs.
# Le fichier .env ne doit JAMAIS être committé (il est dans .gitignore).
# Toutes les valeurs ci-dessous sont fictives.

# ----- Base de données (développement local) -----
POSTGRES_DB=studio
POSTGRES_USER=studio
POSTGRES_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/studio

# ----- Backend -----
SERVER_PORT=8080
# Secret pour signer les sessions. Générer une valeur aléatoire longue.
JWT_SECRET=change-me-long-random-value
# Clé pour chiffrer les jetons stockés (si vous en stockez). 32 octets en base64.
TOKEN_ENCRYPTION_KEY=change-me

# ----- Connexion GitHub (application OAuth créée dans l'organisation) -----
GITHUB_OAUTH_CLIENT_ID=change-me
GITHUB_OAUTH_CLIENT_SECRET=change-me
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/github/callback

# ----- IA -----
AI_PROVIDER=change-me
AI_API_KEY=change-me
AI_MODEL=change-me
# Nombre maximal d'appels IA par utilisateur et par jour
AI_DAILY_QUOTA=30

# ----- Temps réel -----
REALTIME_PORT=1234
NEXT_PUBLIC_REALTIME_URL=ws://localhost:1234

# ----- Frontend -----
NEXT_PUBLIC_API_URL=http://localhost:8080

# ----- Déploiement Systalink (secrets à mettre dans GitHub Secrets, pas ici) -----
# SYSTALINK_SSH_HOST
# SYSTALINK_SSH_USER
# SYSTALINK_SSH_PRIVATE_KEY
