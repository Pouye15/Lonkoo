# Copier ce fichier en .env et remplacer les valeurs.
# Lu par : le backend en profil « dev » (-Dspring-boot.run.profiles=dev), le serveur temps réel avec « npm run dev »
# et docker compose (--env-file .env). L'interface, elle, lit frontend/.env.local (voir README, « Démarrer en local »).
# Le fichier .env ne doit JAMAIS être committé (il est dans .gitignore).
# Toutes les valeurs ci-dessous sont fictives. En profil « prod », le backend refuse de démarrer si une valeur
# « change-me » subsiste (en développement, il l'écrit dans les journaux sans s'arrêter).
# Générer un secret : openssl rand -base64 32

# ----- Base de données (développement local) -----
POSTGRES_DB=lonkoo
POSTGRES_USER=lonkoo
POSTGRES_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/lonkoo

# ----- Backend -----
SERVER_PORT=8080
# « dev » en local, « prod » sur le serveur : « prod » active le cookie de session Secure et le contrôle de la
# configuration au démarrage (secrets, https). À positionner dans le compose de production.
SPRING_PROFILES_ACTIVE=dev
# Invités éphémères : durée de vie (heures) et nombre maximal créés par adresse et par heure
GUEST_TTL_HOURS=24
# Invités créés par heure et par adresse. Plusieurs personnes derrière une même adresse (salle de jury, Wi-Fi partagé)
# se partagent la limite : 60 à 100 en production si besoin.
GUEST_RATE_LIMIT_PER_HOUR=20
# Plafonds d'usage (409 « Limite atteinte » au-delà) : projets créés par invité et par compte GitHub,
# canvas par projet, versions et liens de partage actifs par canvas, taille d'un instantané (octets)
MAX_PROJECTS_PER_GUEST=20
MAX_PROJECTS_PER_ACCOUNT=100
MAX_CANVASES_PER_PROJECT=10
MAX_VERSIONS_PER_CANVAS=50
MAX_SHARE_LINKS_PER_CANVAS=20
MAX_SNAPSHOT_BYTES=1048576
# Générations de projet par canvas, taille maximale (octets) des fichiers d'un projet généré,
# et demandes de déploiement par projet généré
MAX_GENERATIONS_PER_CANVAS=20
MAX_GENERATED_BYTES=8388608
MAX_DEPLOYMENTS_PER_GENERATION=20
# Minutes au-delà desquelles un travail resté « en cours » (génération, envoi GitHub, lancement de déploiement) est marqué échoué
JOB_STALE_MINUTES=30
# Adresse publique de l'application (en local : le frontend ; en production : https://votre-domaine)
APP_PUBLIC_URL=http://localhost:3000

# ----- Temps réel -----
REALTIME_PORT=1234
# Secret partagé : le backend signe les tickets de connexion, le serveur temps réel les vérifie.
# Au moins 32 caractères, sinon le backend refuse de démarrer (générer : openssl rand -hex 32).
REALTIME_TICKET_SECRET=change-me-avec-au-moins-32-caracteres
# Jeton de service, dans les deux sens : le serveur temps réel le présente au backend (/internal/canvases/{id}/state)
# et le backend le présente au serveur temps réel (instantané, restauration). Au moins 16 caractères en production.
REALTIME_SERVICE_TOKEN=change-me
# Adresse du serveur temps réel vue depuis le backend (en conteneur : http://realtime:1234)
REALTIME_INTERNAL_URL=http://localhost:1234
# Adresse du backend. Cette variable sert à deux services avec deux valeurs :
#  - le proxy /api du frontend en développement : http://localhost:8080 ;
#  - le serveur temps réel dans son conteneur : http://backend:8080 (valeur à donner dans le compose, pas ici).
BACKEND_INTERNAL_URL=http://localhost:8080
# Réglages facultatifs du serveur temps réel (valeurs par défaut indiquées) :
# REALTIME_STORE_DEBOUNCE_MS=3000
# REALTIME_MAX_MESSAGE_BYTES=2097152
# Délai maximal d'un appel du backend au serveur temps réel, en secondes
# REALTIME_REQUEST_TIMEOUT_SECONDS=10

# ----- Connexion GitHub (application OAuth créée sur le compte GitHub du propriétaire du dépôt) -----
# Portées demandées : read:user et public_repo (connexion ordinaire) ; sur choix explicite de l'utilisateur, "?access=deploy"
# demande aussi repo et workflow (lancer le déploiement, dépôt privé). Aucun jeton n'est stocké.
GITHUB_OAUTH_CLIENT_ID=change-me
GITHUB_OAUTH_CLIENT_SECRET=change-me
# Le callback est géré par le backend (en local, le frontend redirige /api vers le backend).
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/github/callback
# Tant que CLIENT_ID ou CLIENT_SECRET porte « change-me », le backend démarre mais /api/auth/github/* répond 503.
# Pas à pas : docs/GITHUB-OAUTH.md. Réglages facultatifs (tests avec un faux GitHub, délai en secondes) :
# GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
# GITHUB_OAUTH_USER_URL=https://api.github.com/user
# GITHUB_OAUTH_REQUEST_TIMEOUT_SECONDS=10
# Envoi d'un projet généré sur GitHub (API REST) : adresse (faux GitHub en test) et délai en secondes.
# GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_API_REQUEST_TIMEOUT_SECONDS=20

# ----- IA (clé côté serveur uniquement, jamais dans une variable NEXT_PUBLIC_*) -----
AI_PROVIDER=change-me
AI_API_KEY=change-me
AI_MODEL=change-me
# Nombre maximal d'appels IA par utilisateur et par jour
AI_DAILY_QUOTA=30
# Délai maximal d'un appel (secondes) et taille maximale de l'entrée (caractères)
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=8000

# ----- Frontend (valeurs lues au build) -----
# Chemin relatif : l'API est servie sur la même origine (Caddy en production, redirection Next en local).
NEXT_PUBLIC_API_URL=/api
# « mock » : session et projets simulés dans le navigateur (aucun backend requis).
# « live » : le front appelle l'API (/api/me, /api/auth/guest, …). Next lit frontend/.env.local, pas ce fichier.
NEXT_PUBLIC_API_MODE=mock
# Vide en production (le navigateur utilise wss://<domaine>/ws). En local :
NEXT_PUBLIC_REALTIME_URL=ws://localhost:1234

# ----- Production (voir docs/DEPLOIEMENT.md) -----
# Adresse servie par Caddy (infra/Caddyfile)
DOMAIN=localhost
# Déploiement des applications générées : hôte dédié, clé SSH propre au backend (chemin du fichier, pas son contenu)
DEPLOY_SSH_HOST=change-me
DEPLOY_SSH_USER=deploy
DEPLOY_SSH_KEY_PATH=change-me

# Déploiement de Lonkoo lui-même : secrets à mettre dans GitHub Secrets, pas ici
# SYSTALINK_SSH_HOST
# SYSTALINK_SSH_USER
# SYSTALINK_SSH_PRIVATE_KEY
