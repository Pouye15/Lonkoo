{
  "schemaVersion": 1,
  "meta": {
    "name": "Clinique : rendez-vous et rappels par SMS",
    "description": "Exemple de démonstration : prise de rendez-vous, dossiers des patients, rappels par SMS et paiement des consultations par paiement mobile."
  },
  "nodes": [
    {
      "id": "n1",
      "type": "webapp",
      "position": {
        "x": 0,
        "y": 160
      },
      "data": {
        "name": "portail_clinique",
        "label": "Portail clinique",
        "pages": [
          "accueil",
          "rendez_vous",
          "dossiers"
        ]
      }
    },
    {
      "id": "n2",
      "type": "auth",
      "position": {
        "x": 260,
        "y": 0
      },
      "data": {
        "name": "connexion",
        "label": "Connexion",
        "method": "otp-sms"
      }
    },
    {
      "id": "n3",
      "type": "service",
      "position": {
        "x": 260,
        "y": 280
      },
      "data": {
        "name": "api_clinique",
        "label": "API clinique",
        "endpoints": [
          {
            "method": "GET",
            "path": "/patients",
            "summary": "Lister les patients"
          },
          {
            "method": "POST",
            "path": "/patients",
            "summary": "Enregistrer un patient"
          },
          {
            "method": "GET",
            "path": "/medecins",
            "summary": "Lister les médecins"
          },
          {
            "method": "POST",
            "path": "/medecins",
            "summary": "Ajouter un médecin"
          },
          {
            "method": "GET",
            "path": "/rendez-vous",
            "summary": "Lister les rendez-vous"
          },
          {
            "method": "POST",
            "path": "/rendez-vous",
            "summary": "Prendre un rendez-vous"
          },
          {
            "method": "GET",
            "path": "/consultations",
            "summary": "Lister les consultations"
          },
          {
            "method": "POST",
            "path": "/consultations",
            "summary": "Enregistrer une consultation"
          },
          {
            "method": "GET",
            "path": "/factures",
            "summary": "Lister les factures"
          },
          {
            "method": "POST",
            "path": "/factures",
            "summary": "Établir la facture d'une consultation"
          }
        ]
      }
    },
    {
      "id": "n4",
      "type": "database",
      "position": {
        "x": 540,
        "y": 280
      },
      "data": {
        "name": "clinique_db",
        "label": "Base clinique",
        "engine": "postgresql",
        "entities": [
          {
            "name": "patient",
            "fields": [
              {
                "name": "numero_dossier",
                "type": "string",
                "required": true,
                "unique": true
              },
              {
                "name": "nom",
                "type": "string",
                "required": true
              },
              {
                "name": "telephone",
                "type": "string",
                "required": true
              },
              {
                "name": "naissance",
                "type": "date"
              },
              {
                "name": "adresse",
                "type": "string"
              }
            ]
          },
          {
            "name": "medecin",
            "fields": [
              {
                "name": "nom",
                "type": "string",
                "required": true
              },
              {
                "name": "specialite",
                "type": "string",
                "required": true
              }
            ]
          },
          {
            "name": "rendez_vous",
            "fields": [
              {
                "name": "patient_id",
                "type": "uuid",
                "required": true
              },
              {
                "name": "medecin_id",
                "type": "uuid",
                "required": true
              },
              {
                "name": "debut",
                "type": "datetime",
                "required": true
              },
              {
                "name": "fin",
                "type": "datetime",
                "required": true
              },
              {
                "name": "motif",
                "type": "string"
              },
              {
                "name": "statut",
                "type": "string",
                "required": true
              }
            ]
          },
          {
            "name": "consultation",
            "fields": [
              {
                "name": "rendez_vous_id",
                "type": "uuid",
                "required": true
              },
              {
                "name": "compte_rendu",
                "type": "text"
              }
            ]
          },
          {
            "name": "facture",
            "fields": [
              {
                "name": "consultation_id",
                "type": "uuid",
                "required": true
              },
              {
                "name": "montant",
                "type": "long",
                "required": true
              },
              {
                "name": "reference_paiement",
                "type": "string",
                "unique": true
              },
              {
                "name": "paye_le",
                "type": "datetime"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "n5",
      "type": "queue",
      "position": {
        "x": 540,
        "y": 80
      },
      "data": {
        "name": "file_rappels",
        "label": "File des rappels",
        "topics": [
          "rendez_vous_crees",
          "rappels_a_envoyer"
        ]
      }
    },
    {
      "id": "n6",
      "type": "messaging",
      "position": {
        "x": 800,
        "y": 80
      },
      "data": {
        "name": "rappels_sms",
        "label": "Rappels par SMS",
        "channel": "sms",
        "templates": [
          {
            "name": "rappel_rdv",
            "text": "Rappel : vous avez un rendez-vous demain à la clinique."
          },
          {
            "name": "annulation_rdv",
            "text": "Votre rendez-vous a été annulé. Contactez la clinique pour en fixer un autre."
          }
        ]
      }
    },
    {
      "id": "n7",
      "type": "mobile-payment",
      "position": {
        "x": 540,
        "y": 460
      },
      "data": {
        "name": "paiement_consultation",
        "label": "Paiement soins",
        "currency": "XOF",
        "flow": "collect"
      }
    },
    {
      "id": "n8",
      "type": "billing",
      "position": {
        "x": 800,
        "y": 460
      },
      "data": {
        "name": "facturation",
        "label": "Facturation",
        "model": "one-time",
        "currency": "XOF"
      }
    }
  ],
  "edges": [
